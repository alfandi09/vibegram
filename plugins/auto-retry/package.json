{
    "name": "@vibegram/auto-retry",
    "version": "0.1.0",
    "description": "Telegram API retry transformer for VibeGram bots",
    "main": "./dist/cjs/index.js",
    "module": "./dist/esm/index.js",
    "types": "./dist/types/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/types/index.d.ts",
            "import": "./dist/esm/index.js",
            "require": "./dist/cjs/index.js"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist",
        "README.md",
        "LICENSE"
    ],
    "sideEffects": false,
    "engines": {
        "node": ">=20.0.0"
    },
    "scripts": {
        "build:cjs": "tsc --project tsconfig.json",
        "build:esm": "tsc --project tsconfig.esm.json",
        "write:package-markers": "node scripts/postbuild.js",
        "build": "npm run build:cjs && npm run build:esm && npm run write:package-markers",
        "test": "npx --no-install vitest run tests",
        "typecheck": "tsc --noEmit",
        "prepack": "node -e \"require('fs').copyFileSync('../../LICENSE','LICENSE')\""
    },
    "keywords": [
        "vibegram",
        "telegram",
        "bot",
        "retry",
        "auto-retry",
        "transformer"
    ],
    "author": "Alfa",
    "license": "ISC",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/alfandi09/vibegram.git",
        "directory": "plugins/auto-retry"
    },
    "bugs": {
        "url": "https://github.com/alfandi09/vibegram/issues"
    },
    "homepage": "https://alfandi09.github.io/vibegram/",
    "peerDependencies": {
        "vibegram": "^3.0.0"
    },
    "devDependencies": {
        "@types/node": "^25.5.2",
        "typescript": "^6.0.2",
        "vitest": "^3.2.4",
        "vibegram": "file:../.."
    },
    "publishConfig": {
        "access": "public"
    }
}
